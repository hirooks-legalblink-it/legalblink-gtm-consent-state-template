___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Reads the lb_csc cookie written by the LegalBlink CMP and returns the granted consent
// categories as a comma-separated list, always in this order:
// necessary,preferences,analytics,marketing. An empty string means that no valid consent
// choice is available, so no category is granted.
const getCookieValues = require('getCookieValues');
const getType = require('getType');
const JSON = require('JSON');

// Category names stored in lb_csc.level, mapped to the public tokens, in output order.
const CATEGORIES = [
  {level: 'necessary_cookies', token: 'necessary'},
  {level: 'first_party_tracking_cookies', token: 'preferences'},
  {level: 'third_party_stats_cookies', token: 'analytics'},
  {level: 'third_party_adv_cookies', token: 'marketing'}
];

// Returns the level array of a valid consent record, or undefined. A record is valid only
// if it is an object whose level is an array that contains necessary_cookies.
function readLevel(value) {
  if (getType(value) !== 'string' || value === '') return undefined;
  const record = JSON.parse(value);
  if (getType(record) !== 'object') return undefined;
  const level = record.level;
  if (getType(level) !== 'array' || level.indexOf('necessary_cookies') === -1) return undefined;
  return level;
}

const values = getCookieValues('lb_csc', false);
if (getType(values) !== 'array' || values.length === 0) return '';

// With more than one lb_csc cookie, one invalid value voids the result, and a category
// counts only if every cookie grants it: an old cookie can never hide a revocation.
const levels = [];
for (let i = 0; i < values.length; i++) {
  const level = readLevel(values[i]);
  if (!level) return '';
  levels.push(level);
}

const tokens = [];
for (let c = 0; c < CATEGORIES.length; c++) {
  let granted = true;
  for (let i = 0; i < levels.length; i++) {
    if (levels[i].indexOf(CATEGORIES[c].level) === -1) granted = false;
  }
  if (granted) tokens.push(CATEGORIES[c].token);
}
return tokens.join(',');


