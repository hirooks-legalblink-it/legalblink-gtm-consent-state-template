___TESTS___

scenarios:
- name: No cookie returns an empty string
  code: |-
    mockCookies([]);
    assertThat(runCode({})).isEqualTo('');
- name: Empty cookie value returns an empty string
  code: |-
    mockCookies(['']);
    assertThat(runCode({})).isEqualTo('');
- name: Missing API result returns an empty string
  code: |-
    mock('getCookieValues', function() { return undefined; });
    assertThat(runCode({})).isEqualTo('');
- name: Reject all returns necessary only
  code: |-
    mockCookies(['{"level":["necessary_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary');
- name: Preferences only
  code: |-
    mockCookies(['{"level":["necessary_cookies","first_party_tracking_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary,preferences');
- name: Analytics only
  code: |-
    mockCookies(['{"level":["necessary_cookies","third_party_stats_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary,analytics');
- name: Marketing only
  code: |-
    mockCookies(['{"level":["necessary_cookies","third_party_adv_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary,marketing');
- name: Analytics and marketing
  code: |-
    mockCookies(['{"level":["necessary_cookies","third_party_stats_cookies","third_party_adv_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary,analytics,marketing');
- name: Accept all returns every token in the fixed order
  code: |-
    mockCookies(['{"level":["necessary_cookies","third_party_adv_cookies","third_party_stats_cookies","first_party_tracking_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary,preferences,analytics,marketing');
- name: Legacy cookie with spaces is read
  code: |-
    mockCookies(['{"level": ["necessary_cookies", "third_party_stats_cookies"], "version": "2"}']);
    assertThat(runCode({})).isEqualTo('necessary,analytics');
- name: Malformed JSON returns an empty string
  code: |-
    mockCookies(['{"level":["necessary_cookies","third_party_adv_cookies"']);
    assertThat(runCode({})).isEqualTo('');
- name: Level as a string is rejected
  code: |-
    mockCookies(['{"level":"necessary_cookies,third_party_adv_cookies","version":"2"}']);
    assertThat(runCode({})).isEqualTo('');
- name: Level without necessary is rejected
  code: |-
    mockCookies(['{"level":["third_party_adv_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('');
- name: Missing level is rejected
  code: |-
    mockCookies(['{"version":"2"}']);
    assertThat(runCode({})).isEqualTo('');
- name: JSON that is not an object is rejected
  code: |-
    const values = ['[]', '["necessary_cookies"]', '42', 'null', 'true', '"necessary_cookies"'];
    for (let i = 0; i < values.length; i++) {
      mockCookies([values[i]]);
      assertThat(runCode({}), values[i]).isEqualTo('');
    }
- name: Fields outside level grant nothing
  code: |-
    mockCookies(['{"level":["necessary_cookies"],"version":"2","third_party_adv_cookies":true,"marketing":true}']);
    assertThat(runCode({})).isEqualTo('necessary');
- name: Unknown and non-string entries are ignored
  code: |-
    mockCookies(['{"level":["necessary_cookies","unknown_cookies",42,null,{"third_party_adv_cookies":true},"third_party_stats_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary,analytics');
- name: Duplicate entries give a single token
  code: |-
    mockCookies(['{"level":["necessary_cookies","third_party_adv_cookies","third_party_adv_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary,marketing');
- name: Two cookies grant only the categories granted in both
  code: |-
    mockCookies([
      '{"level":["necessary_cookies","third_party_adv_cookies","third_party_stats_cookies"],"version":"2"}',
      '{"level":["necessary_cookies","third_party_stats_cookies"],"version":"2"}'
    ]);
    assertThat(runCode({})).isEqualTo('necessary,analytics');
- name: Two cookies with one invalid return an empty string
  code: |-
    mockCookies([
      '{"level":["necessary_cookies","third_party_adv_cookies"],"version":"2"}',
      '{bad'
    ]);
    assertThat(runCode({})).isEqualTo('');
- name: Revocation on the same page is reflected
  code: |-
    mockCookies(['{"level":["necessary_cookies","third_party_adv_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary,marketing');
    mockCookies(['{"level":["necessary_cookies"],"version":"2"}']);
    assertThat(runCode({})).isEqualTo('necessary');
- name: Every combination satisfies exactly its contains conditions
  code: |-
    const levels = {
      preferences: 'first_party_tracking_cookies',
      analytics: 'third_party_stats_cookies',
      marketing: 'third_party_adv_cookies'
    };
    const tokens = ['preferences', 'analytics', 'marketing'];
    const combos = [
      [], ['preferences'], ['analytics'], ['marketing'],
      ['preferences', 'analytics'], ['preferences', 'marketing'], ['analytics', 'marketing'],
      ['preferences', 'analytics', 'marketing']
    ];
    for (let c = 0; c < combos.length; c++) {
      const level = ['necessary_cookies'];
      for (let i = 0; i < combos[c].length; i++) {
        level.push(levels[combos[c][i]]);
      }
      mockCookies(['{"level":["' + level.join('","') + '"],"version":"2"}']);
      const result = runCode({});
      for (let t = 0; t < tokens.length; t++) {
        const expected = combos[c].indexOf(tokens[t]) !== -1;
        assertThat(result.indexOf(tokens[t]) !== -1, combos[c].join('+') + ' / ' + tokens[t]).isEqualTo(expected);
      }
    }
- name: Reads lb_csc without URI decoding
  code: |-
    mockCookies([]);
    runCode({});
    assertApi('getCookieValues').wasCalledWith('lb_csc', false);
setup: |-
  // Values exactly as the LegalBlink CMP writes lb_csc: raw JSON, no URI encoding.
  const mockCookies = function(values) {
    mock('getCookieValues', function(name, decode) {
      return name === 'lb_csc' ? values : [];
    });
  };


___NOTES___

LegalBlink Consent State reads the lb_csc cookie, the same source the LegalBlink CMP tag
template uses, and returns the granted categories for trigger conditions such as
"contains marketing".
